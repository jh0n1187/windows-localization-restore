*.ps1 text eol=crlf
*.cmd text eol=crlf
*.md  text eol=crlf
*.csv text eol=crlf
*.json text eol=crlf
# exportacoes do regedit sao UTF-16 LE
*.reg binary
*.dll binary
*.exe binary
*.mui binary
*.cat binary
# Conteudo extraido da imagem do Windows: validado por SHA256 (manifest.csv), NUNCA converter fim de linha (.admx/.adml)
Profiles/*/Files/** -text
Profiles/*/Catalogs/** -text
Profiles/*/Tasks/** -text
Profiles/*/Files/manifest.csv text eol=crlf
